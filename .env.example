# Required — powers Classifier and Curator (Claude Sonnet reasoning calls).
ANTHROPIC_API_KEY=

# Optional — Reddit signals are skipped gracefully if unset (Trends/CFPB/RSS
# need no credentials at all).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignalHarvest/1.0

# Pipeline tuning
SENTINEL_MAX_SIGNALS_PER_SOURCE=50
CURATOR_MIN_SCORE=40
SCHEDULER_HOUR=1
SCHEDULER_MINUTE=0
LOG_LEVEL=INFO

# Storage / output paths (container-local — see the deploy notes on why
# this is fine for a portfolio deployment but not a durable one)
DATABASE_PATH=./data/signalharvest.db
DIGEST_OUTPUT_DIR=./output/digests
LOG_FILE=./logs/signalharvest.log

# Gateway (added for the HTTP API — CLI-only usage doesn't need these)
# Must match the frontend's SIGNALHARVEST_API_KEY — sent as the X-API-Key
# header on every proxied request.
SIGNALHARVEST_API_KEY=
# Comma-separated browser origins allowed to call the API directly (CORS).
# Empty means none — the intended path is always the frontend's own
# server-side proxy, which isn't subject to CORS at all.
ALLOWED_ORIGINS=
ENVIRONMENT=development
